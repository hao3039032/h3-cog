# The published REF2VA base contains the verified weights, CUDA/PyTorch, and
# ComfyUI. Rebuild SageAttention so Studio images can also run on SM120.
ARG BASE_IMAGE=r8.im/hao3039032/minimax-h3:latest
FROM ${BASE_IMAGE}

RUN rm -rf /opt/ComfyUI/custom_nodes/raylight

RUN git -C /opt/ComfyUI fetch origin v0.31.0 \
    && git -C /opt/ComfyUI checkout 43cb4fffc89bba20ab7bd61467a36d0339338dab \
    && python -m pip install --break-system-packages --no-cache-dir \
        -r /opt/ComfyUI/requirements.txt

RUN rm -rf /opt/ComfyUI/custom_nodes/ComfyUI-sol-attn \
    && git clone https://github.com/Saganaki22/ComfyUI-sol-attn.git \
        /opt/ComfyUI/custom_nodes/ComfyUI-sol-attn \
    && git -C /opt/ComfyUI/custom_nodes/ComfyUI-sol-attn \
        checkout 930a4d6e432ff8b8ed5e30ff2f72519b92d69bdf

RUN TORCH_CUDA_ARCH_LIST='8.0;8.9;12.0' MAX_JOBS=4 python -m pip install \
    --break-system-packages --no-cache-dir --no-build-isolation \
    --force-reinstall --no-deps \
    git+https://github.com/thu-ml/SageAttention.git@eb615cf6cf4d221338033340ee2de1c37fbdba4a

RUN python -m pip install --break-system-packages --no-cache-dir \
    'gradio>=6.24,<7' 'cryptography<46'

COPY . /src
WORKDIR /src

ENV PORT=7860

EXPOSE 7860
CMD ["python", "-u", "/src/app.py"]
