# Review and accept the MiniMax license before enabling generation.
MINIMAX_H3_LICENSE_ACCEPTED=1

H3_PORT=7860
H3_GRADIO_IMAGE=h3-gradio:local
H3_PARALLEL_MODE=single
H3_VIDEO_VAE_PRECISION=fp32
H3_BAKED_WEIGHTS_VERIFIED=0
SAGE_CUDA_ARCH_LIST=8.9;12.0
MAX_JOBS=4

# Optional reverse-proxy correction. Leave blank on normal platforms.
GRADIO_PUBLIC_PORT=
GRADIO_PUBLIC_PROTO=
