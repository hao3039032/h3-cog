# Extend the verified baked REF2VA release without rebuilding or re-uploading
# its four large weight layers. Unlike Dockerfile.modelscope, this preserves
# Cog's HTTP server command for Replicate.
ARG BASE_IMAGE=r8.im/hao3039032/minimax-h3:latest
FROM ${BASE_IMAGE}

RUN git -C /opt/ComfyUI fetch origin v0.31.0 \
    && git -C /opt/ComfyUI checkout 43cb4fffc89bba20ab7bd61467a36d0339338dab \
    && python -m pip install --break-system-packages --no-cache-dir \
        -r /opt/ComfyUI/requirements.txt

RUN TORCH_CUDA_ARCH_LIST='8.0;8.9;12.0' MAX_JOBS=4 python -m pip install \
    --break-system-packages --no-cache-dir --no-build-isolation \
    --force-reinstall --no-deps \
    git+https://github.com/thu-ml/SageAttention.git@eb615cf6cf4d221338033340ee2de1c37fbdba4a

RUN git clone https://github.com/komikndr/raylight.git /opt/ComfyUI/custom_nodes/raylight \
    && git -C /opt/ComfyUI/custom_nodes/raylight checkout 9a7c33d52b3d35e29f75ecff3c227de987f0d4cf \
    && python -m pip install --break-system-packages --no-cache-dir \
        'ray>=2.48,<3' 'xfuser>=0.4.4,<0.6' kernels huggingface_hub hf_transfer \
        'gradio>=6.24,<7' 'cryptography<46' \
    && python -m pip install --break-system-packages --no-cache-dir --no-deps \
        -e /opt/ComfyUI/custom_nodes/raylight

COPY . /src
WORKDIR /src

ENV H3_PARALLEL_MODE=single

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["python", "-m", "cog.server.http"]
